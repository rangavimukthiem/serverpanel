# ---------------------------------------------------------
# EKAFY Cloud SaaS Platform - Environment Variables Template
# ---------------------------------------------------------

# ==========================================
# 1. Core Infrastructure & Domains
# ==========================================

# Domain for the Server Manager Control Panel (Admin Dashboard)
MANAGER_DOMAIN=dashboard.ekafy.com

# Domain for the Webmin Host System Panel
WEBMIN_DOMAIN=panel.ekafy.com

# Base domain for customer tenant SaaS applications (*.ekafy.com)
CORE_DOMAIN=ekafy.com

# Email used for Let's Encrypt automated SSL certificates
SSL_EMAIL=admin@ekafy.com

# Database Root & Admin Credentials
DB_ROOT_PASSWORD=your_secure_root_password
DB_ADMIN_PASSWORD=your_secure_admin_password

# Redis In-Memory Engine Password
REDIS_PASSWORD=your_secure_redis_password

# ==========================================
# 2. Server Manager & Google OAuth (SSO)
# ==========================================

# JWT Session Secret & Expiration
JWT_SECRET=your_secure_random_jwt_secret
JWT_EXPIRES_IN=8h

# Google OAuth Credentials (Google Cloud Console Web Client)
# Authorized JavaScript origins: https://dashboard.ekafy.com
# Authorized redirect URIs:      https://dashboard.ekafy.com/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://dashboard.ekafy.com/api/auth/google/callback

# Allow automatic signup for newly authorized Google accounts
GOOGLE_OAUTH_ALLOW_SIGNUP=false

# Access restrictions: Comma-separated allowed emails or domains (Leave blank for open admin whitelist)
GOOGLE_OAUTH_ALLOWED_EMAILS=
GOOGLE_OAUTH_ALLOWED_DOMAINS=

# ==========================================
# 3. Backups & Disaster Recovery
# ==========================================

# Backup snapshot directory and optional rclone remote destination
BACKUP_ROOT=/app/backups
GOOGLE_DRIVE_REMOTE=
