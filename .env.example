PORT=3000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ekafy
DB_PASSWORD=change-me
DB_NAME=ekafy
DB_ADMIN_HOST=127.0.0.1
DB_ADMIN_PORT=3306
DB_ADMIN_USER=ekafy_admin
DB_ADMIN_PASSWORD=change-me-admin

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
ALLOW_REGISTRATION=false

# Google OAuth web client. Register this exact callback URL in Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://panel.example.com/api/auth/google/callback
# Existing linked identities can always sign in. Set true to create new EKAFY users.
GOOGLE_OAUTH_ALLOW_SIGNUP=false
# Optional comma-separated access restrictions; leave both blank to allow any verified email.
GOOGLE_OAUTH_ALLOWED_EMAILS=
GOOGLE_OAUTH_ALLOWED_DOMAINS=

# Service control is disabled by default so local development cannot accidentally
# run systemctl. Set to true only on the target Linux VPS.
ENABLE_SERVICE_CONTROL=false

# Managed project paths must stay inside this root.
PROJECTS_ROOT=/srv

# Used by Certbot when provisioning Let's Encrypt certificates for project domains.
SSL_EMAIL=admin@example.com

# Keep false for Cloudflare Full (strict). Set true only for local/dev testing.
ALLOW_SELF_SIGNED_SSL=false

# Default PHP-FPM socket for PHP, WordPress, and WooCommerce projects.
PHP_FPM_SOCKET=/run/php/php8.1-fpm.sock

# Defaults used when EKAFY creates project-owned systemd units.
PROJECT_SERVICE_USER=ekafy
PROJECT_SERVICE_GROUP=ekafy
PROJECT_SERVICE_NPM_BIN=/usr/bin/npm
PROJECT_SERVICE_NODE_BIN=/usr/bin/node
PROJECT_SERVICE_PYTHON_BIN=/usr/bin/python3

# Database wizard Excel imports.
EXCEL_IMPORT_MAX_BYTES=10485760
EXCEL_IMPORT_MAX_ROWS=5000

# Project backup archives. GOOGLE_DRIVE_REMOTE is an rclone destination.
BACKUP_ROOT=/srv/ekafy/backups
GOOGLE_DRIVE_REMOTE=
MARIADB_DUMP_BIN=mariadb-dump
MARIADB_BIN=mariadb
