# ---------------------------------------------------------
# EKAFY SaaS Platform - Environment Variables
# ---------------------------------------------------------

# ==========================================
# 1. Core Infrastructure (Docker & Traefik)
# ==========================================

# The domain for the Server Manager (Admin Panel)
MANAGER_DOMAIN=dashboard.ekafy.com

# The domain for Webmin (Host OS Management)
WEBMIN_DOMAIN=panel.ekafy.com

# The base domain for the customer applications (Core App)
# Customer apps will automatically get *.example.com
CORE_DOMAIN=ekafy.com

# Email used for Let's Encrypt SSL certificates (Traefik)
SSL_EMAIL=rangavimukthiem@gmail.com

# Database Passwords (Must be strong and secure)
DB_ROOT_PASSWORD=your_secure_root_password
DB_ADMIN_PASSWORD=your_secure_admin_password

# Redis Password
REDIS_PASSWORD=your_secure_redis_password

# ==========================================
# 2. Server Manager & API Configuration
# ==========================================

# JWT Secret for Session Authentication
JWT_SECRET=your_secure_random_jwt_secret
JWT_EXPIRES_IN=8h
ALLOW_REGISTRATION=false

# Google OAuth web client. Register this exact callback URL in Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://admin.example.com/api/auth/google/callback

# Existing linked identities can always sign in. Set true to create new EKAFY users.
GOOGLE_OAUTH_ALLOW_SIGNUP=false

# Optional comma-separated access restrictions; leave both blank to allow any verified email.
GOOGLE_OAUTH_ALLOWED_EMAILS=
GOOGLE_OAUTH_ALLOWED_DOMAINS=

# ==========================================
# 3. Backups & Storage
# ==========================================

# Project backup archives. GOOGLE_DRIVE_REMOTE is an rclone destination.
BACKUP_ROOT=/app/backups
GOOGLE_DRIVE_REMOTE=
